@model List<CodeQuest.Models.ProgrammingLanguage>

@{
    ViewData["Title"] = "Programming Languages";
}

<div class="languages-page">

    <h1>🚀 Choose Your Coding Adventure!</h1>

    <p>Click a programming language to begin your journey.</p>

    <div class="language-grid">

        @foreach (var language in Model)
        {
            <div class="language-card">

                <div class="language-icon">
                    @language.Icon
                </div>

                <h2>@language.Name</h2>

                <p>@language.Description</p>

                <span class="difficulty">
                    @language.Difficulty
                </span>

                <div class="lesson-info">
                    📚 1 Lesson
                </div>

                <div class="xp-info">
                    ⭐ Earn 50 XP
                </div>

                <a asp-controller="Lesson"
                 asp-action="Details"
                 asp-route-id="@language.Id"
                 class="start-btn">🚀 Start Learning</a>

            </div>
        }

    </div>

</div>